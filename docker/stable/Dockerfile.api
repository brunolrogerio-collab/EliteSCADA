FROM mcr.microsoft.com/dotnet/sdk:10.0.400-noble AS build
WORKDIR /src

COPY . .
RUN dotnet restore src/Scada.Api/Scada.Api.csproj
RUN dotnet publish src/Scada.Api/Scada.Api.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/sdk:10.0.400-noble AS runtime
USER root
RUN apt-get update \
    && apt-get install --yes --no-install-recommends python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build --chown=app:app /app/publish .
COPY --chown=app:app docker/stable/start-api.py /app/start-api.py
RUN mkdir -p /app/data/protected-material /app/host-keys \
    && chown -R app:app /app/data /app/host-keys \
    && chmod 700 /app/data/protected-material /app/host-keys
ENV ASPNETCORE_HTTP_PORTS=5080 \
    DOTNET_NOLOGO=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1
EXPOSE 5080
USER app
ENTRYPOINT ["python3", "/app/start-api.py"]
