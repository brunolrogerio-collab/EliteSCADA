# The Playwright image pins the browser stack to @playwright/test 1.62.1 on
# Ubuntu. The overlays below align the remaining CI toolchains with GitHub CI.
FROM mcr.microsoft.com/playwright:v1.62.1-noble

USER root

ARG NODE_VERSION=24.19.0
ARG DOTNET_SDK_VERSION=10.0.400

ENV DOTNET_ROOT=/usr/share/dotnet \
    PATH=/usr/share/dotnet:/opt/node/bin:${PATH} \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    DOTNET_NOLOGO=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl python3 xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --location --silent --show-error \
        "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    | tar --extract --xz --file - --directory /opt \
    && mv "/opt/node-v${NODE_VERSION}-linux-x64" /opt/node

RUN curl --fail --location --silent --show-error https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && bash /tmp/dotnet-install.sh --version "${DOTNET_SDK_VERSION}" --install-dir "${DOTNET_ROOT}" \
    && rm /tmp/dotnet-install.sh \
    && node --version | grep --fixed-strings "v${NODE_VERSION}" \
    && dotnet --version | grep --fixed-strings "${DOTNET_SDK_VERSION}"
