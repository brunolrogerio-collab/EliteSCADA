FROM node:24.19.0-alpine AS build
WORKDIR /web

COPY web/scada-web/package.json web/scada-web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/scada-web/ ./
RUN npm run build

FROM nginx:1.29-alpine AS runtime
COPY docker/stable/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
