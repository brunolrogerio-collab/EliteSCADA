{
  "name": "EliteSCADA W15 E4 Transport",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/EliteSCADA",
  "shutdownAction": "stopCompose",
  "initializeCommand": "bash .devcontainer/initialize-preview-machine-id.sh",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "EliteSCADA Web — W15 E4",
      "onAutoForward": "openPreview"
    },
    "5080": {
      "label": "EliteSCADA API — internal only",
      "onAutoForward": "ignore"
    }
  },
  "postCreateCommand": "dotnet --version && dotnet restore ScadaPlatform.sln && cd web/scada-web && npm ci --no-audit --no-fund",
  "postAttachCommand": "bash scripts/preview/launch-w15-e4-transport.sh",
  "containerEnv": {
    "DOTNET_NOLOGO": "true",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit"
      ]
    }
  }
}
