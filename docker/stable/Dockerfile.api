FROM mcr.microsoft.com/dotnet/sdk:10.0.400-noble AS build
WORKDIR /src

COPY . .
RUN dotnet restore src/Scada.Api/Scada.Api.csproj
RUN dotnet publish src/Scada.Api/Scada.Api.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/sdk:10.0.400-noble AS runtime
USER root
RUN apt-get update \
    && apt-get install --yes --no-install-recommends python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build --chown=app:app /app/publish .
ENV ASPNETCORE_HTTP_PORTS=5080 \
    DOTNET_NOLOGO=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1
EXPOSE 5080
USER app
ENTRYPOINT ["dotnet", "Scada.Api.dll"]
