  {
    "id": "http-publish",
    "type": "http in",
    "z": "tab-control",
    "name": "POST /lab/mqtt/publish",
    "url": "/lab/mqtt/publish",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 190,
    "y": 210,
    "wires": [["fn-publish"]]
  },
  {
    "id": "fn-publish",
    "type": "function",
    "z": "tab-control",
    "name": "validate + publish",
    "func": "const body = msg.payload && typeof msg.payload === \"object\" ? msg.payload : {};\nconst topic = typeof body.topic === \"string\" && body.topic.trim()\n  ? body.topic.trim()\n  : \"elitescada/lab/control\";\nconst qos = [0, 1, 2].includes(Number(body.qos)) ? Number(body.qos) : 0;\nconst retain = body.retain === true;\nconst value = Object.prototype.hasOwnProperty.call(body, \"payload\")\n  ? body.payload\n  : { generatedAt: new Date().toISOString() };\n\nconst publish = { ...msg };\npublish.topic = topic;\npublish.qos = qos;\npublish.retain = retain;\npublish.payload = typeof value === \"string\" ? value : JSON.stringify(value);\n\nconst reply = { ...msg };\nreply.statusCode = 202;\nreply.headers = {\"content-type\":\"application/json\"};\nreply.payload = { accepted: true, topic, qos, retain };\nreturn [publish, reply];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 210,
    "wires": [["mqtt-out"], ["http-publish-response"]]
  },
