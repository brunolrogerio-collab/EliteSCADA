  {
    "id": "fn-config",
    "type": "function",
    "z": "tab-control",
    "name": "public lab config",
    "func": "msg.headers = {\"content-type\":\"application/json\"};\nmsg.payload = {\n  eliteScadaBaseUrl: env.get(\"ELITESCADA_BASE_URL\") || null,\n  mqttHost: env.get(\"LAB_MQTT_HOST\") || \"mosquitto\",\n  mqttPort: Number(env.get(\"LAB_MQTT_PORT\") || 1883),\n  opcUaPort: 4840\n};\nreturn msg;",
