  {
    "id": "mqtt-in",
    "type": "mqtt in",
    "z": "tab-control",
    "name": "observe lab topics",
    "topic": "elitescada/lab/#",
    "qos": "2",
    "datatype": "auto-detect",
    "broker": "8b54a1263d1472e1",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 180,
    "y": 320,
    "wires": [["fn-observe"]]
  },
  {
    "id": "fn-observe",
    "type": "function",
    "z": "tab-control",
    "name": "store last observation",
    "func": "let value = msg.payload;\nif (Buffer.isBuffer(value)) {\n  value = { base64: value.toString(\"base64\"), encoding: \"base64\" };\n}\nconst observation = {\n  topic: msg.topic,\n  payload: value,\n  qos: msg.qos ?? null,\n  retain: msg.retain === true,\n  observedAt: new Date().toISOString()\n};\nglobal.set(\"mqtt.last\", observation);\nmsg.payload = observation;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 320,
    "wires": [["debug-observe"]]
  },
