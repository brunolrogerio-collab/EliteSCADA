    "name": "reset volatile observations",
    "func": "global.set(\"mqtt.last\", null);\nmsg.headers = {\"content-type\":\"application/json\"};\nmsg.payload = { reset: true, observedAt: new Date().toISOString() };\nreturn msg;",
