  {
    "id": "fn-last",
    "type": "function",
    "z": "tab-control",
    "name": "read last observation",
    "func": "const last = global.get(\"mqtt.last\") || null;\nmsg.headers = {\"content-type\":\"application/json\"};\nmsg.payload = { observed: last !== null, last };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
