{
  "name": "EliteSCADA first-project preview harness",
  "dockerComposeFile": "../ci/local/docker-compose.preview.yml",
  "service": "preview",
  "workspaceFolder": "/workspace",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "EliteSCADA Product Owner Preview",
      "onAutoForward": "notify"
    },
    "5080": {
      "label": "EliteSCADA API (internal)",
      "onAutoForward": "ignore"
    },
    "5432": {
      "label": "EliteSCADA TimescaleDB (internal)",
      "onAutoForward": "ignore"
    }
  },
  "postStartCommand": "bash /workspace/scripts/preview/codespaces-public-web-port.sh",
  "containerEnv": {
    "DOTNET_NOLOGO": "true",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit"]
    }
  }
}
