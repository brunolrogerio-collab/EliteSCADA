# Host ports are loopback-only and intentionally differ from local test defaults.
# Keep this ID and its .env stable for the lifetime of an installation. Use a
# different ID, directory and independently generated secrets for another copy.
SCADIVO_INSTALLATION_ID=elitescada-stable
SCADIVO_WEB_BIND=127.0.0.1
SCADIVO_API_BIND=127.0.0.1
ELITESCADA_WEB_PORT=18080
ELITESCADA_API_PORT=15120
ELITESCADA_DB_PORT=15432
SCADIVO_MEDIA_CONTROL_PORT=9997
SCADIVO_MEDIA_PLAYBACK_PORT=8888

# Supply unique local values before `docker compose -f docker-compose.stable.yml up`.
ELITESCADA_DB_PASSWORD=replace-with-a-long-random-password
ELITESCADA_HISTORICAL_CURSOR_KEY_BASE64=replace-with-base64-encoded-32-random-bytes
ELITESCADA_JWT_ISSUER=elitescada-local
ELITESCADA_JWT_AUDIENCE=elitescada-local-browser
ELITESCADA_JWT_SIGNING_KEY=replace-with-a-unique-random-secret-at-least-32-bytes
ELITESCADA_MACHINE_ID=replace-with-a-unique-stable-random-machine-id
