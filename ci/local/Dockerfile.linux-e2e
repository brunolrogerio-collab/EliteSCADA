# Keep the complete Linux toolchain reproducible and fetch it only through
# verified container-registry TLS. The tags document versions; digests pin bytes.
FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df AS node-toolchain
FROM mcr.microsoft.com/dotnet/sdk:10.0.400-noble@sha256:4beef5b8919dcaa2dc924233bd069257e883cc7a061e09088a97d152d6a48510 AS dotnet-toolchain
FROM mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e

ARG PREVIEW_DEPENDENCY_KEY=unprepared
ARG PREVIEW_DEPENDENCY_INPUTS_SHA=unprepared
ARG PREVIEW_HARNESS_SHA=unprepared
ARG PREVIEW_PRODUCT_BASE_SHA=unprepared

LABEL com.elitescada.preview.dependency-key=${PREVIEW_DEPENDENCY_KEY} \
    com.elitescada.preview.dependency-inputs-sha=${PREVIEW_DEPENDENCY_INPUTS_SHA} \
    com.elitescada.preview.harness-sha=${PREVIEW_HARNESS_SHA} \
    com.elitescada.preview.product-base-sha=${PREVIEW_PRODUCT_BASE_SHA}

USER root

COPY --from=node-toolchain /usr/local/ /opt/node/
COPY --from=dotnet-toolchain /usr/share/dotnet/ /usr/share/dotnet/

ENV DOTNET_ROOT=/usr/share/dotnet \
    PATH=/usr/share/dotnet:/opt/node/bin:${PATH} \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    DOTNET_NOLOGO=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1

RUN node --version | grep --fixed-strings 'v24.19.0' \
    && dotnet --version | grep --fixed-strings '10.0.400'
