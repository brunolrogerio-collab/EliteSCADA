<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Scada.Core/Scada.Core.csproj" />
    <ProjectReference Include="../Scada.Drivers/Scada.Drivers.csproj" />
    <ProjectReference Include="../Scada.DriverHost/Scada.DriverHost.csproj" />
    <ProjectReference Include="../Scada.Historian/Scada.Historian.csproj" />
    <ProjectReference Include="../Scada.Historian.TimescaleDb/Scada.Historian.TimescaleDb.csproj" />
    <ProjectReference Include="../Scada.Engineering/Scada.Engineering.csproj" />
    <ProjectReference Include="../Scada.Persistence.PostgreSql/Scada.Persistence.PostgreSql.csproj" />
    <ProjectReference Include="../Scada.Security/Scada.Security.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Scada.Drivers.Tests" />
  </ItemGroup>

  <Target Name="IncludeEliteScadaDnp3DistributionFiles" AfterTargets="ComputeFilesToPublish"
          Condition="'$(EliteScadaDnp3HostPath)' != '' or '$(EliteScadaDnp3NoticesPath)' != '' or '$(EliteScadaRequireDnp3NativeHost)' == 'true'">
    <Error Condition="'$(EliteScadaRequireDnp3NativeHost)' == 'true' and '$(EliteScadaDnp3HostPath)' == ''"
           Text="EliteScadaRequireDnp3NativeHost=true requires EliteScadaDnp3HostPath." />
    <Error Condition="'$(EliteScadaRequireDnp3NativeHost)' == 'true' and '$(EliteScadaDnp3NoticesPath)' == ''"
           Text="EliteScadaRequireDnp3NativeHost=true requires EliteScadaDnp3NoticesPath." />
    <Error Condition="'$(EliteScadaDnp3HostPath)' != '' and !Exists('$(EliteScadaDnp3HostPath)')"
           Text="Configured EliteSCADA DNP3 native host does not exist: $(EliteScadaDnp3HostPath)" />
    <Error Condition="'$(EliteScadaDnp3NoticesPath)' != '' and !Exists('$(EliteScadaDnp3NoticesPath)')"
           Text="Configured EliteSCADA DNP3 third-party notices do not exist: $(EliteScadaDnp3NoticesPath)" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(EliteScadaDnp3HostPath)" Condition="'$(EliteScadaDnp3HostPath)' != ''">
        <RelativePath>native/dnp3/EliteScada.Dnp3Host.exe</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(EliteScadaDnp3NoticesPath)" Condition="'$(EliteScadaDnp3NoticesPath)' != ''">
        <RelativePath>third-party/dnp3/DNP3-THIRD-PARTY-NOTICES.txt</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
