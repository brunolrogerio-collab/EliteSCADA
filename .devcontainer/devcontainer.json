{
  "name": "EliteSCADA Test Preview",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/EliteSCADA",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "EliteSCADA Web — Test Preview",
      "onAutoForward": "openPreview"
    },
    "5080": {
      "label": "EliteSCADA API — internal only",
      "onAutoForward": "ignore"
    }
  },
  "postCreateCommand": "dotnet restore ScadaPlatform.sln && cd web/scada-web && npm ci --no-audit --no-fund",
  "postAttachCommand": "bash scripts/preview/launch-test-preview.sh",
  "containerEnv": {
    "DOTNET_NOLOGO": "true",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },
  "secrets": {
    "ELITESCADA_PREVIEW_ADMIN_PASSWORD": {
      "description": "Administrative password for the disposable EliteSCADA Test Preview account. Never commit this value to the repository."
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit"
      ]
    }
  }
}
